include README.md
include LICENSE
include pyproject.toml
recursive-include src/monocr *.py
# Exclude model checkpoints - downloaded on demand
exclude src/monocr/models/*.ckpt
exclude src/monocr/models/*.pt
exclude src/monocr/models/*.pth
recursive-include src/monocr/assets *.txt
recursive-include tests *.py
recursive-include examples *.py
recursive-include examples/images *.png
recursive-include examples/images *.jpg
global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
